{
  "name": "setupninja",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Phone-first setup assistant for deterministic proof G-code review.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -g @a11y",
    "test:visual": "playwright test tests/e2e/setupninja.visual.spec.ts",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.32.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
